# --- Project metadata ---
include README.md
include LICENSE
include pyproject.toml

# --- Cython sources and C/C++ headers ---
recursive-include decision_graph *.pyx *.pxd *.pxi
recursive-include decision_graph *.h *.c *.cpp

# --- Web UI resources ---
recursive-include decision_graph *.html *.css *.js

# --- Exclude unnecessary files ---
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.so
global-exclude *.pyd
global-exclude *.dll
global-exclude *.o
global-exclude *.obj